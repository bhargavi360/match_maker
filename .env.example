# Run npm run local:configure to create fresh development secrets without printing them.
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
MATCHMAKER_SETUP_TOKEN=replace-with-32-random-bytes-encoded-as-hex
CONTACT_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
CONTACT_KEY_ID=local-v1
# Optional Stage 5 provider. Leave disabled for fully local matching/search.
GEMINI_ENABLED=false
GEMINI_API_KEY=replace-with-your-own-private-gemini-api-key
# Choose a supported Gemini text model; no automatic model alias is selected.
GEMINI_MODEL=gemini-your-approved-model
# Optional absolute owned path, outside OneDrive:
# DATABASE_URL=file:C:/Users/your-user/AppData/Local/MatchmakerAIRebuild/matchmaker.sqlite
# Optional Stage 7. Drafts/editing/copy/export need no email provider.
# Only bare email addresses are accepted for sender/reply-to.
RESEND_API_KEY=replace-with-your-own-private-resend-api-key
RESEND_FROM_EMAIL=matchmaker@your-verified-domain.example
RESEND_REPLY_TO=matchmaker@your-verified-domain.example
RESEND_WEBHOOK_SECRET=replace-with-your-resend-webhook-signing-secret
# Must equal BETTER_AUTH_URL. Public webhook hosting requires HTTPS.
APP_ORIGIN=http://127.0.0.1:3100
